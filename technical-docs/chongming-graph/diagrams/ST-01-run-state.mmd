%% Scope: Run aggregate state, Operation state and orthogonal pause
%%{init: {"theme": "base", "themeVariables": {"primaryColor": "#e8fbfb", "primaryBorderColor": "#159a9c", "primaryTextColor": "#263238", "lineColor": "#455a64"}}}%%
flowchart TB
  S[启动并冻结范围与配置] --> D[派生多个 Operation]
  D --> OR[Operation 运行中]
  OR --> OW[Operation 等待审核]
  OW -->|批准路由| OR
  OW -->|批准结果| OC[Operation 已完成]
  OW -->|拒绝| OF[Operation 已失败]
  OR -->|自动接受产物或空结果| OC
  OC --> D
  D -->|存在运行项| RR[Run 运行中]
  D -->|仅剩待审项| RW[Run 等待审核]
  D -->|闭包全部完成| RC[Run 已完成]
  OF --> RF[Run 已失败]
  RR --> X[显式取消]
  RW --> X
  RR -.暂停保留状态与成果.-> P[paused=true]
  RW -.暂停保留审核.-> P
  P -.继续重新派生未完成工作.-> D
  classDef c fill:#e8fbfb,stroke:#159a9c,color:#263238;
  class S,D,OR,OW,OC,OF,RR,RW,RC,RF,X,P c;
