# Independent local mode: npm run local:serve (Node.js 24+). Mongo/AMQP settings below apply only to collaboration.
# Host / Graph API. Export these in the launch environment, or use .chongming-host settings.
# A MongoDB replica set is required; there is no in-memory database fallback.
CHONGMING_MONGO_URI=mongodb://127.0.0.1:27017/chongming_graph
CHONGMING_AMQP_URL=amqp://replace-user:replace-password@127.0.0.1:5672
CHONGMING_QUEUE_NAMESPACE=chongming
CHONGMING_DATA_TOKEN=replace-with-private-host-token
CHONGMING_DATA_API=http://127.0.0.1:4320
DEEPSEEK_API_KEY=replace-with-model-key
TAVILY_API_KEY=replace-with-search-key

# User-facing CLI / web development proxy. This token is issued to a user, not the Host.
CHONGMING_GRAPH_API=http://127.0.0.1:4320
CHONGMING_USER_TOKEN=replace-with-user-token
# Model/provider, tools and prompts are configured in the management workspace.
# .env is not automatically loaded by the desktop client or CLI.
