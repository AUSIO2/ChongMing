# DeepSeek（OpenAI 兼容接口）
DEEPSEEK_API_KEY=your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Tavily（web_search tool；核查 SubAgent 外证用）
TAVILY_API_KEY=your-tavily-api-key-here

# MongoDB（Mongoose）
# 留空或填 mongodb://... ；填 memory 强制使用内存库
# 若配置的地址连接失败，会自动 fallback 到 mongodb-memory-server
MONGO_URI=mongodb://localhost:27017/chongming
