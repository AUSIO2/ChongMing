{
  "name": "chongming",
  "private": true,
  "version": "0.2.0",
  "description": "重明 — 事实核查智能体",
  "author": "AUSIO2 <ian666xiong@gmail.com>",
  "scripts": {
    "dev": "env -u ELECTRON_RUN_AS_NODE vite",
    "build": "vite build && electron-builder",
    "build:check": "vue-tsc && vite build && electron-builder",
    "preview": "vite preview",
    "test": "vitest run --config vitest.config.ts",
    "test:dsh": "vitest run --config vitest.config.ts tests/backend/dsh.spec.ts",
    "test:graph": "vitest run --config vitest.config.ts tests/backend/graph.spec.ts",
    "test:run": "vitest run --config vitest.config.ts tests/backend/run.spec.ts tests/backend/dsh-business.spec.ts tests/backend/dsh-verify.spec.ts",
    "test:map": "vitest run --config vitest.config.ts tests/flow-map",
    "dsh:serve": "node --import tsx backend/main.ts",
    "dsh:verify": "node --import tsx backend/dsh-verify-cli.ts",
    "graph:serve": "node --import tsx backend/graph-main.ts",
    "headless": "node --import tsx server/cli.ts"
  },
  "dependencies": {
    "@deepseek-ai/dsh-sdk-client": "0.1.5-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.1",
    "@langchain/core": "^1.2.1",
    "@langchain/langgraph": "^1.4.7",
    "@langchain/openai": "^1.5.3",
    "langsmith": "^0.7.14",
    "mongoose": "^9.7.3",
    "pinia": "^2.1.7",
    "vue": "^3.4.21",
    "vue-router": "^4.3.2"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "electron": "^30.0.1",
    "electron-builder": "^24.13.3",
    "mongodb-memory-server": "^11.2.0",
    "tsx": "^4.19.3",
    "typescript": "^5.2.2",
    "vite": "^5.1.6",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^4.1.9",
    "vue-tsc": "^2.0.26"
  },
  "main": "dist-electron/main.js"
}
